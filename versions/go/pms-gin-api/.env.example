# 复制为 .env 后按需修改；系统环境变量优先于 .env
# 数据库（与其他版本共用账号体系）
DB_NAME=pms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Gin API 默认端口
SERVER_PORT=8081

# 三版共用的 API Token 签名密钥，生产环境必须替换
API_SECRET=dev-insecure-api-secret-change-me

# Vue 开发服务器的跨域来源；部署时替换为实际前端 origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 首次启动（users 表为空）自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
