# 复制为 .env 后按需修改；系统环境变量优先于 .env
# 数据库（与 Django / Spring Boot / FastAPI / Gin 版可共用同一个库与账号体系）
DB_NAME=pms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Gin 版默认端口
SERVER_PORT=8081

# 三版共用的 API Token 签名密钥，生产环境必须替换
API_SECRET=dev-insecure-api-secret-change-me

# 页面会话 Cookie 签名密钥，生产环境必须替换
SESSION_SECRET=dev-insecure-session-secret-change-me

# 会话 / CSRF Cookie 是否仅 HTTPS 传输（本地开发保持 false）
COOKIE_SECURE=false

# 首次启动（users 表为空）自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
