# 复制为 .env 后按需修改；系统环境变量优先于 .env
# 数据库（与 Django / Spring Boot / Gin 版可共用同一个库与账号体系）
DB_NAME=pms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

SERVER_PORT=8000

# 三版共用的 Token 签名密钥，生产环境必须替换
API_SECRET=dev-insecure-api-secret-change-me

# 首次启动（users 表为空）自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 允许的前端来源，多个用逗号分隔
CORS_ORIGINS=*
