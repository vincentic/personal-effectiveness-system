# 复制为 .env 后按需修改；启动脚本 start.sh 会自动加载
DEBUG=true

# 数据库（与原 Django 版同名，便于复用同一个 MySQL 实例）
DB_NAME=pms
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 应用端口
SERVER_PORT=8080

# 首次启动（users 表为空）自动创建的管理员账号，生产环境必须修改
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
API_SECRET=dev-insecure-api-secret-change-me

# Vue 开发服务器的跨域来源；部署时替换为实际前端 origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
